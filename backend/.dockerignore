# Build context for the backend image. Everything listed here is either a
# local-only artifact or a secret that must never end up in a layer.

# --- Secrets: the container gets its config from compose env_file / -e flags,
# --- never from a baked-in .env. Keep it that way.
.env
.env.*
!env.example

# --- Local virtualenv / caches (the image builds its own venv with uv)
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- VCS / tooling
.git/
.gitignore
.dockerignore
Dockerfile
.vscode/
.idea/
*.swp
*.swo

# --- Logs & scratch
*.log
logs/
example.txt

# --- OS noise
.DS_Store
Thumbs.db

# --- Docker artifacts
*.tar
