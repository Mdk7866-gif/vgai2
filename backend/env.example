# vgAI backend — LOCAL DEVELOPMENT env template.
#
#   cp env.example .env        (then fill in the real values)
#
# Every variable here is declared on app/config.py's `Settings`. Anything not
# declared there is ignored (`extra="ignore"`), so adding a stray key is
# harmless but pointless — if you add a real one, add it to Settings too.
#
# NOT the deployment env file. The Docker/EC2 stack reads a single root
# `.env` built from the repo-root `.env.example` instead; see awsdeployment.md.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Comma-separated CORS allowlist. 3000 is vgAI's own frontend — do NOT point
# this at 3001, which belongs to the sibling vgai2admin portal.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Supabase (Postgres + Google OAuth)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Service-role key: bypasses Row Level Security entirely, so every per-user
# scoping check has to happen in route code. Server-side only, never shipped.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Cloudinary (media storage — see README.md §9 for the folder layout)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder every asset nests under. Keep identical to what's already in use,
# or existing media stops resolving.
CLOUDINARY_FOLDER_NAME=vgai2

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# OpenAI: character sheets, style templates, scene/thumbnail images, "base"
# tier scene splitting, prompt rewrites (app/openai_client.py).
CHATGPT_PAID_API_KEY=
# OpenRouter: Perplexity topic research, Claude script generation, and
# image-to-video animation (app/openrouter_client.py, app/openrouter_video.py).
OPENROUTER_PAID_API_KEY=
# Gemini: "pro" tier scene splitting only (app/gemini_client.py).
GEMINI_PAID_API_KEY=

# ---------------------------------------------------------------------------
# Razorpay (credit top-ups — app/routes/payments/)
# ---------------------------------------------------------------------------
# Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed once app/routes/payments/webhook.py is registered, which requires
# a real deployed domain (Razorpay refuses localhost). See awsdeployment.md §10.
RAZORPAY_WEBHOOK_SECRET=
