# =========================
# Python bytecode & cache
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/

# =========================
# uv package manager
# =========================
.uv/
# uv.lock is deliberately NOT ignored — it is the lockfile the Docker build
# runs `uv sync` against, so leaving it untracked means a fresh clone on the
# server resolves its own (possibly different) dependency versions. Commit it.

# =========================
# Build & packaging
# =========================
build/
dist/
wheels/
*.egg-info/
.eggs/

# =========================
# FastAPI / Uvicorn
# =========================
*.log
logs/
.env
.env.*
!env.example

# =========================
# Testing & coverage
# =========================
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# =========================
# IDEs & Editors
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
