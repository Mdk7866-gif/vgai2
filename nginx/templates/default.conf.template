# vgAI reverse proxy.
#
# ${DOMAIN} is the ONLY placeholder in this file. The nginx service in
# docker-compose.yml renders it with `envsubst '$DOMAIN'` at container start —
# the quoted filter is what stops envsubst from also eating nginx's own runtime
# variables ($host, $request_uri, $remote_addr, ...), which are left untouched.
#
# Everything the browser touches is served from a single origin:
#   https://${DOMAIN}/       -> the Next.js container   (frontend:3000)
#   https://${DOMAIN}/api/   -> the FastAPI container   (backend:8000)
#
# One origin means the frontend can call the backend at the relative path /api,
# so no domain name is baked into the JavaScript bundle and CORS never comes
# into play.

# Sends `Connection: upgrade` only on requests that actually asked to upgrade,
# and `Connection: close` otherwise. Hardcoding "upgrade" on every proxied
# request instead is a common copy-paste bug that confuses keep-alive handling.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------------------
# Port 80 — ACME challenges, and a redirect for everything else
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt writes its challenge files into this shared volume; this
    # location must stay reachable over plain HTTP or renewals fail.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# Port 443 — the real site
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Inlined rather than `include /etc/letsencrypt/options-ssl-nginx.conf` —
    # that file only exists if certbot's nginx plugin installed it, and this
    # setup uses certonly, so the include would make nginx refuse to start.
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Scene animations are uploaded straight through this proxy (a user's own
    # video file, via /projects/scenes/{id}/upload_animation). nginx's 1 MB
    # default would reject those with a 413 long before FastAPI sees them.
    client_max_body_size 200M;
    client_body_timeout  300s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml image/svg+xml;

    # -----------------------------------------------------------------------
    # Backend — the trailing slash on proxy_pass strips the /api prefix, so
    # /api/users/me arrives at FastAPI as /users/me. Don't remove it.
    # -----------------------------------------------------------------------
    location /api/ {
        proxy_pass http://backend:8000/;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Image, animation and scene-split generation are long blocking calls —
        # animation in particular polls an OpenRouter video job until it
        # finishes. nginx's 60s default would cut those off mid-flight, and the
        # user would be charged for a generation they never received (credits
        # are reserved before the provider call — see README §2).
        proxy_connect_timeout 60s;
        proxy_send_timeout    900s;
        proxy_read_timeout    900s;

        # Stream the response as it arrives rather than accumulating it first.
        proxy_buffering off;
    }

    # A bare /api (no trailing slash) would otherwise fall through to the
    # frontend and 404.
    location = /api {
        return 301 /api/;
    }

    # -----------------------------------------------------------------------
    # Frontend — everything else
    # -----------------------------------------------------------------------
    location / {
        proxy_pass http://frontend:3000;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 120s;
    }
}
