# vgAI deployment configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. docker-compose.yml reads
# this one file for everything: variable substitution (DOMAIN, build args) and
# the backend container's own environment.
#
# NOTE ON LOCAL DEV: this file is only for the Docker/EC2 stack. Running the
# app locally still uses backend/.env and frontendweb/.env.local as before —
# nothing here replaces those.

# ---------------------------------------------------------------------------
# Domain — the ONE place the hostname is written
# ---------------------------------------------------------------------------
# No scheme, no trailing slash, no www. Used for nginx's server_name, the
# Let's Encrypt certificate paths, and the backend's CORS allowlist.
# After changing it: re-issue the certificate (awsdeployment.md §6) and run
# `docker compose up -d --force-recreate nginx backend`. The frontend needs no
# rebuild, because it calls the backend at the relative path /api.
DOMAIN=vgai2.com

# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Frontend build args — baked into the browser bundle at BUILD time
# ---------------------------------------------------------------------------
# Changing any of these needs `docker compose build frontend`, not a restart.
# The anon key is public by design (it is shipped to every browser); the
# service-role key below is NOT and must never be given a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave as /api unless the backend is moved to a different host. Relative means
# the domain never enters the frontend bundle.
NEXT_PUBLIC_BACKEND_URL=/api

# ---------------------------------------------------------------------------
# Backend — Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Service-role key: bypasses Row Level Security entirely. Server-side only.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Backend — Cloudinary (media storage, see README §9)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder every asset is nested under. Keep it identical to what production
# already uses, or existing media stops resolving.
CLOUDINARY_FOLDER_NAME=vgai2

# ---------------------------------------------------------------------------
# Backend — AI providers
# ---------------------------------------------------------------------------
# OpenAI: character sheets, style templates, scene/thumbnail images, "base"
# tier scene splitting, prompt rewrites.
CHATGPT_PAID_API_KEY=
# OpenRouter: Perplexity topic research, Claude script generation, animation.
OPENROUTER_PAID_API_KEY=
# Gemini: "pro" tier scene splitting only.
GEMINI_PAID_API_KEY=
# ElevenLabs: voiceover TTS. Not wired up yet — the route is an unregistered
# stub — so this can stay empty until that ships.
# ELEVEN_LABS_PAID_API_KEY=

# ---------------------------------------------------------------------------
# Backend — Razorpay (credit top-ups)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed once app/routes/payments/webhook.py is activated, which requires
# the real domain this deployment finally gives you. See awsdeployment.md §10.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# uvicorn worker processes. Each loads the full LangChain/OpenAI import tree
# (roughly 250-350 MB), so 2 is a sensible ceiling on a 2 GB instance. Raise it
# on a larger box; 2 x vCPU is the usual starting point.
UVICORN_WORKERS=2
